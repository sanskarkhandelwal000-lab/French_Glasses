<ul class="capte-pdp-assure" role="list" lang="fr" {{ block.shopify_attributes }}>
  {%- for i in (1..3) -%}
    {%- capture t %}item_{{ i }}{% endcapture -%}
    {%- if block.settings[t] != blank -%}
      <li>
        <span class="capte-pdp-assure__icon" aria-hidden="true">
          {%- case i -%}
            {%- when 1 -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10.5" width="14" height="9.5" rx="2"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/></svg>
            {%- when 2 -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12a8 8 0 1 0 2.6-5.9"/><path d="M4 4.5v4h4"/></svg>
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5 5 6v5.5c0 4.3 2.8 7.4 7 9 4.2-1.6 7-4.7 7-9V6z"/><path d="m9 12 2.2 2.2L15.2 10"/></svg>
          {%- endcase -%}
        </span>
        <span>{{ block.settings[t] }}</span>
      </li>
    {%- endif -%}
  {%- endfor -%}
  {%- if block.settings.delivery != blank -%}
    <li class="capte-pdp-assure__delivery">{{ block.settings.delivery }}</li>
  {%- endif -%}
</ul>

{% schema %}
{
  "name": "Capté — Réassurance",
  "settings": [
    { "type": "text", "id": "item_1", "label": "Item 1", "default": "Paiement sécurisé" },
    { "type": "text", "id": "item_2", "label": "Item 2", "default": "Retours 14 jours" },
    { "type": "text", "id": "item_3", "label": "Item 3", "default": "Garantie 2 ans" },
    { "type": "text", "id": "delivery", "label": "Delivery information", "default": "📦 Livraison estimée entre 8 et 12 jours ouvrés après expédition." }
  ],
  "presets": [{ "name": "Capté — Réassurance" }]
}
{% endschema %}
