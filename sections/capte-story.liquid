<section class="capte capte__section capte-story-section" id="capte-story" lang="fr">
  <div class="capte__wrap">
    <div class="capte-story__grid">
      <div class="capte-story__body capte-reveal">
        {%- if section.settings.eyebrow != blank -%}
          <p class="capte__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="capte__title capte__title--lg" style="margin-bottom: 2rem;">{{ section.settings.heading }}</h2>
        {{ section.settings.text }}
        <p class="capte-story__sign">{{ section.settings.signature }}</p>
      </div>

      <div class="capte-story__media capte-reveal">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag: widths: '600, 900, 1400', sizes: '(min-width: 60em) 45vw, 100vw', loading: 'lazy', alt: section.settings.image.alt
          }}
        {%- elsif section.settings.use_bundled_image -%}
          {%- render 'capte-asset-img', name: 'capte-story', alt: section.settings.image_alt, sizes: '(min-width: 60em) 45vw, 100vw' -%}
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="capte-values">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <strong>{{ block.settings.title }}</strong>
            <span>{{ block.settings.text }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Capté — Histoire",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "À propos" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Les plus beaux moments ne se vivent pas derrière un écran." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Capté est né d'une idée simple : une descente dans la poudreuse, un coucher de soleil entre amis, une conversation à l'autre bout du monde… On sort son téléphone, on cadre, et l'instant est déjà passé.</p><p>Avec Capté, vos lunettes deviennent votre caméra. Vous filmez ce que vous voyez, mains libres, sans quitter le moment.</p><p>Nous sommes une marque française, transparente sur nos produits, proche de nos clients et attachée à un usage respectueux : on filme ses aventures, pas les autres.</p>"
    },
    { "type": "text", "id": "signature", "label": "Signature", "default": "Capté. Tout est capté." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "use_bundled_image", "label": "Use the bundled image when none is picked", "default": true },
    { "type": "text", "id": "image_alt", "label": "Bundled image alt text", "default": "Un skieur de dos sur une crête enneigée, face à une mer de nuages au coucher du soleil" }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Valeur",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Vrai" },
        { "type": "text", "id": "text", "label": "Text", "default": "De vraies images, de vraies fonctions, de vrais prix." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Capté — Histoire",
      "blocks": [
        { "type": "value", "settings": { "title": "Vrai", "text": "De vraies images, de vraies fonctions, de vrais prix." } },
        { "type": "value", "settings": { "title": "Libre", "text": "Mains libres, pour vivre le moment." } },
        { "type": "value", "settings": { "title": "Respectueux", "text": "On filme ses aventures et ses proches, jamais des inconnus." } },
        { "type": "value", "settings": { "title": "Proche", "text": "Une marque française qui vous répond en français." } }
      ]
    }
  ]
}
{% endschema %}
