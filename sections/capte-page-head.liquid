{%- comment -%}
  Page header for content pages (Notre histoire, FAQ, Contact…). Renders the page's H1.
{%- endcomment -%}
{%- assign head_text = section.settings.heading | default: page.title -%}
<section class="capte capte-pagehead" lang="fr">
  <div class="capte__wrap">
    <div class="capte-pagehead__inner capte-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="capte__eyebrow"><span class="capte__rec" aria-hidden="true"></span>{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="capte__title capte__title--xl">{%- render 'capte-hl', text: head_text -%}</h1>
      {%- if section.settings.text != blank -%}
        <p class="capte-pagehead__lead">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Capté — En-tête de page",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Capté" },
    { "type": "text", "id": "heading", "label": "Heading (H1)", "info": "Wrap words in *asterisks* to highlight them in colour. Empty = page title.", "default": "" },
    { "type": "textarea", "id": "text", "label": "Introduction", "default": "" }
  ],
  "presets": [{ "name": "Capté — En-tête de page" }]
}
{% endschema %}
