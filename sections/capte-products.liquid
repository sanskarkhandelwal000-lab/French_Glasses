{%- liquid
  assign source = section.settings.collection
  if source == blank
    assign source = collections.all
  endif
  assign limit = section.settings.limit
-%}

{%- comment -%}
  Renders nothing on the storefront when the collection is empty, so Shopify's
  placeholder products never appear. The theme editor shows a short hint instead.
{%- endcomment -%}
{%- if source.products_count > 0 -%}
  <section class="capte capte__section capte-products{% if section.settings.dark %} capte--dark{% endif %}">
    <div class="capte__wrap">
      <div class="capte-products__head capte-reveal">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="capte__eyebrow">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          <h2 class="capte__title capte__title--lg">{{ section.settings.heading }}</h2>
        </div>
        {%- if section.settings.link_label != blank -%}
          <a class="capte__btn capte__btn--ghost" href="{{ source.url }}">{{ section.settings.link_label }}</a>
        {%- endif -%}
      </div>

      <ul class="capte-products__grid" role="list">
        {%- for product in source.products limit: limit -%}
          {%- assign image = product.featured_media.preview_image -%}
          {%- assign hover = product.media[1].preview_image -%}
          <li class="capte-card capte-reveal">
            <a class="capte-card__link" href="{{ product.url }}">
              {%- liquid
                assign accent = '#8A8590'
                if product.type contains 'Glisse'
                  assign accent = '#8EC5E8'
                elsif product.type contains 'Soleil'
                  assign accent = '#FFB23E'
                elsif product.type contains 'Clair'
                  assign accent = '#CFD6DE'
                endif
              -%}
              <div class="capte-card__media{% if hover %} capte-card__media--swap{% endif %}" style="--accent: {{ accent }};">
                {%- if image -%}
                  {{
                    image
                    | image_url: width: 1200
                    | image_tag: widths: '400, 600, 800, 1200', sizes: '(min-width: 64em) 33vw, (min-width: 40em) 50vw, 100vw', loading: 'lazy', class: 'capte-card__img', alt: product.title
                  }}
                  {%- if hover -%}
                    {{
                      hover
                      | image_url: width: 1200
                      | image_tag: widths: '400, 600, 800, 1200', sizes: '(min-width: 64em) 33vw, (min-width: 40em) 50vw, 100vw', loading: 'lazy', class: 'capte-card__img capte-card__img--hover', alt: ''
                    }}
                  {%- endif -%}
                {%- else -%}
                  <span class="capte-card__noimg" aria-hidden="true">
                    <span class="capte-card__noimg-mark">{{ product.type | default: 'Capté' }}</span>
                    <span class="capte-card__noimg-name">{{ product.title | remove: 'Capté' | strip }}</span>
                  </span>
                {%- endif -%}
                {%- unless product.available -%}
                  <span class="capte-card__badge">{{ 'products.product.sold_out' | t }}</span>
                {%- endunless -%}
              </div>
              <div class="capte-card__body">
                {%- if product.type != blank -%}
                  <p class="capte-card__type">{{ product.type }}</p>
                {%- endif -%}
                <h3 class="capte-card__title">{{ product.title }}</h3>
                <p class="capte-card__price">
                  {%- if product.price_varies -%}
                    À partir de {{ product.price_min | money -}}
                  {%- else -%}
                    {{- product.price | money -}}
                  {%- endif -%}
                  {%- if product.compare_at_price > product.price -%}
                    <s>{{ product.compare_at_price | money }}</s>
                  {%- endif -%}
                </p>
                {%- if product.variants.size > 1 -%}
                  <p class="capte-card__variants">{{ product.variants.size }} {{ product.options.first | downcase }}</p>
                {%- endif -%}
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <div class="capte capte__section">
    <div class="capte__wrap">
      <p class="capte__lead">{{ section.settings.heading }} : aucun produit dans cette collection. Cette section reste masquée sur la boutique tant qu'elle est vide.</p>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Capté — Produits",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "La collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choisissez votre regard." },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to show all products." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Tout voir" },
    { "type": "checkbox", "id": "dark", "label": "Dark background", "default": false }
  ],
  "presets": [{ "name": "Capté — Produits" }]
}
{% endschema %}
