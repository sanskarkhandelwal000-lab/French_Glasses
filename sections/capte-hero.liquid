<section class="capte capte--dark capte-hero" id="capte-hero-{{ section.id }}" lang="fr">
  {%- if section.settings.use_theme_video -%}
    <div class="capte-hero__media">
      <video
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
        aria-hidden="true"
        tabindex="-1"
        poster="{{ 'capte-hero-poster.jpg' | asset_url }}"
      >
        <source src="{{ 'capte-hero.mp4' | asset_url }}" type="video/mp4">
      </video>
    </div>
  {%- elsif section.settings.video != blank -%}
    <div class="capte-hero__media">
      {{
        section.settings.video
        | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1920x'
      }}
    </div>
  {%- elsif section.settings.image != blank -%}
    <div class="capte-hero__media">
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag: widths: '800, 1200, 1600, 2000, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.image.alt
      }}
    </div>
  {%- endif -%}

  <div class="capte__wrap capte-hero__inner">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="capte__eyebrow"><span class="capte__rec" aria-hidden="true"></span>{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h1 class="capte__display">{%- render 'capte-hl', text: section.settings.heading -%}</h1>

      {%- if section.settings.subheading != blank -%}
        <p class="capte__lead">{{ section.settings.subheading }}</p>
      {%- endif -%}

      <div class="capte__btns">
        {%- if section.settings.primary_label != blank -%}
          <a class="capte__btn capte__btn--primary" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">
            {{- section.settings.primary_label -}}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a class="capte__btn capte__btn--ghost" href="{{ section.settings.secondary_link | default: '#capte-lines' }}">
            {{- section.settings.secondary_label -}}
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.virtual_notice != blank -%}
      <p class="capte-hero__notice">{{ section.settings.virtual_notice }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="capte-hero__meta">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}><strong>{{ block.settings.value }}</strong> {{ block.settings.label }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Capté — Hero",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Lunettes caméra françaises" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Wrap words in *asterisks* to highlight them in colour.", "default": "Tout est capté." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Filmez ce que vous voyez, mains libres, sans quitter le moment." },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Découvrir la collection" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Nos gammes" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
    { "type": "checkbox", "id": "use_theme_video", "label": "Use the bundled hero video (assets/capte-hero.mp4)", "default": true },
    { "type": "text", "id": "virtual_notice", "label": "Notice for AI-generated imagery", "info": "Required by French law (2023-451) when images contain AI-generated faces.", "default": "Images virtuelles" },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "video", "id": "video", "label": "Background video (overrides image)" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "8 MP" },
        { "type": "text", "id": "label", "label": "Label", "default": "caméra intégrée" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Capté — Hero",
      "blocks": [
        { "type": "stat", "settings": { "value": "8 MP", "label": "caméra intégrée" } },
        { "type": "stat", "settings": { "value": "IA", "label": "traduction et assistant" } },
        { "type": "stat", "settings": { "value": "Mains libres", "label": "photo, vidéo, appels" } }
      ]
    }
  ]
}
{% endschema %}
