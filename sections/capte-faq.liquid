<section class="capte capte--dark capte__section capte-faq" id="capte-faq" lang="fr">
  <div class="capte__wrap">
    <div class="capte-faq__grid">
      <div class="capte-reveal">
        {%- if section.settings.eyebrow != blank -%}
          <p class="capte__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="capte__title capte__title--lg">{{ section.settings.heading }}</h2>
      </div>

      <div>
        {%- for block in section.blocks -%}
          <details {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question }}</summary>
            <div class="capte-faq__a">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Capté — FAQ",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "T'as capté ? On vous explique." }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Réponse.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Capté — FAQ",
      "blocks": [
        { "type": "item", "settings": { "question": "Comment fonctionne la caméra ?", "answer": "<p>Une caméra 8 MP est intégrée à la monture. Vous prenez des photos et des vidéos en vue subjective, mains libres.</p>" } },
        { "type": "item", "settings": { "question": "Les lunettes traduisent-elles en direct ?", "answer": "<p>Oui, la traduction par IA fait partie des fonctions de la gamme.</p>" } },
        { "type": "item", "settings": { "question": "Puis-je mettre des verres correcteurs ?", "answer": "<p>La compatibilité avec la correction visuelle dépend du modèle. Écrivez-nous avant de commander, nous vous répondrons précisément.</p>" } },
        { "type": "item", "settings": { "question": "Quel usage est respectueux de la vie privée ?", "answer": "<p>On filme ses aventures et ses proches, jamais des inconnus. Respectez toujours les personnes autour de vous et la réglementation en vigueur.</p>" } }
      ]
    }
  ]
}
{% endschema %}
